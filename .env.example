# ---------------------------------------------------------------------------
# Keiito Painting - Variables d'environnement
# Copie ce fichier en .env.local et renseigne les valeurs de ton projet Supabase.
# (Project Settings > API dans le dashboard Supabase)
# ---------------------------------------------------------------------------

# URL publique du projet Supabase, ex: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé "anon / public" (safe pour le navigateur, protégée par les policies RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" - SECRETE. Utilisée UNIQUEMENT côté serveur
# (script de création d'admin, jamais exposée au navigateur).
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (utilisée pour le SEO / sitemap / OpenGraph)
# En local: http://localhost:3000 - en prod: https://keiitopainting.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
